# qBittorrent 配置
QBIT_HOST=http://192.168.1.69:8085
QBIT_USERNAME=admin
QBIT_PASSWORD=128012

# 服务配置
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8899

# 爬虫配置
CRAWLER_TIMEOUT=30
CRAWLER_MAX_DEPTH=2
CRAWLER_CONCURRENCY=3
CRAWLER_HEADLESS=true

# 下载路径完全由 qBittorrent API 自动管理
# 每个厂牌（如 SexArt）的路径通过 qB API createCategory 自动创建
#
# 可选：如果脚本和 qB 不在同一台机器上，且你需要脚本主动创建目录：
# FS_BASE_PATH=Z:\downloads   # Windows 通过 SMB 挂载 NAS
# FS_BASE_PATH=/downloads     # 脚本与 qB 在同一环境
# 留空则只依赖 qB API 管理目录

# 高级配置
MIN_DISK_SPACE_GB=10.0

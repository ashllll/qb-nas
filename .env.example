# 飞牛下载中心：先在 NAS 安装并配置 aria2bridge
# https://github.com/jjsxjxj/fnos-aria2-bridge
ARIA2_RPC_URL=http://nas.local:6800/jsonrpc
ARIA2_SECRET=
# 留空使用桥接默认目录；填写时使用 NAS 真实路径，如 /vol3/1000/Download
ARIA2_SAVE_PATH=
ARIA2_SYNC_INTERVAL=2.0

# 服务配置
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8899
# 监听非 loopback 地址时必须设置强随机密钥
API_KEY=
# 仅限明确的本地开发场景；生产环境保持 false
ALLOW_INSECURE_WRITE_API=false

# 爬虫配置
CRAWLER_TIMEOUT=30
CRAWLER_MAX_DEPTH=2
CRAWLER_CONCURRENCY=6
CRAWLER_MAX_DETAIL_LINKS=200
CRAWLER_HEADLESS=true
CRAWLER_HTTP_FIRST=true
CRAWLER_DISABLE_RESOURCES=true
CRAWLER_BLOCK_ADS=true
CRAWLER_ALLOWED_RESOLUTIONS=2160p,4k
CRAWLER_WAIT_UNTIL=load
CRAWLER_DELAY_BEFORE_HTML=1.0
CRAWLER_SCAN_FULL_PAGE=true
CRAWLER_SCROLL_DELAY=0.2
CRAWLER_MAX_SCROLL_STEPS=8
CRAWLER_PROCESS_IFRAMES=true
CRAWLER_FLATTEN_SHADOW_DOM=true
CRAWLER_REMOVE_OVERLAYS=true
CRAWLER_REMOVE_CONSENT_POPUPS=true
CRAWLER_MAX_RETRIES=1
CRAWLER_CHECK_ROBOTS_TXT=false
# 允许 mihomo/Clash fake-IP(198.18.0.0/15) 作为爬取目标（仅域名解析豁免，字面 IP 始终拒绝，默认关闭）
CRAWLER_ALLOW_FAKE_IP=false

# 分类子目录由下载中心创建，无需把 NAS 下载目录挂载到采集服务容器。
MIN_DISK_SPACE_GB=10.0

# 站点 Cookie（需要登录的目标网站）
# JSON 格式，key=域名，value=完整Cookie字符串
# 获取方式：浏览器登录目标网站后 F12→Application→Cookies→全选复制
# 示例: SITE_COOKIES={"example.com": "uid=123; sid=abc"}
SITE_COOKIES={}

# 日志配置
# LOG_LEVEL=DEBUG         # DEBUG / INFO / WARNING / ERROR
# LOG_FILE=data/magnet-harvester.log  # 留空仅控制台，填路径同时输出到文件（自动轮转）

# 存储后端
# STORE_BACKEND=memory    # "memory" 或 "sqlite"
# STORE_DB_PATH=data/magnet_items.db

# qBittorrent 配置
QBIT_HOST=http://192.168.1.69:8085
QBIT_USERNAME=admin
QBIT_PASSWORD=128012

# MiniMax API 配置（从 https://platform.minimaxi.com/user-center/basic-information/interface-key 获取）
MINIMAX_API_KEY=your-minimax-api-key
# 注意：MINIMAX_API_KEY 仅用于 Agent 对话，磁力分类已切换为本地规则，不再需要 AI

# TTS 配置
TTS_ENABLED=true

# 服务配置
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8899

# 爬虫配置
CRAWLER_TIMEOUT=30
CRAWLER_MAX_DEPTH=2
CRAWLER_CONCURRENCY=3
CRAWLER_HEADLESS=true

# 下载路径配置（请根据你的NAS实际路径修改）
PATH_MOVIE=/vol2/1000/downloads/电影
PATH_TV=/vol2/1000/downloads/电视剧
PATH_ANIME=/vol2/1000/downloads/动漫
PATH_MUSIC=/vol2/1000/downloads/音乐
PATH_GAME=/vol2/1000/downloads/游戏
PATH_SOFTWARE=/vol2/1000/downloads/软件
PATH_VARIETY=/vol2/1000/downloads/综艺
PATH_DOCUMENTARY=/vol2/1000/downloads/纪录片
PATH_OTHER=/vol2/1000/downloads/其他

# 高级配置
MIN_DISK_SPACE_GB=10.0
AUTO_CREATE_DIRS=true
PATH_TEMPLATE_ENABLED=false

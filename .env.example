# ── qBittorrent ──────────────────────────────────────────
QBIT_HOST=http://192.168.1.100:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=adminadmin

# ── MiniMax API ───────────────────────────────────────────
# 获取：https://platform.minimaxi.com/user-center/basic-information/interface-key
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_MODEL=MiniMax-M2.5-highspeed
MINIMAX_THINKING_MODEL=MiniMax-M2.5
THINKING_RECHECK=true

# ── TTS 语音通知 ──────────────────────────────────────────
TTS_ENABLED=true

# ── 下载路径（按需修改）──────────────────────────────────
PATH_MOVIE=/volume1/downloads/movies
PATH_TV=/volume1/downloads/tv
PATH_ANIME=/volume1/downloads/anime
PATH_MUSIC=/volume1/downloads/music
PATH_GAME=/volume1/downloads/games
PATH_SOFTWARE=/volume1/downloads/software
PATH_VARIETY=/volume1/downloads/variety
PATH_DOCUMENTARY=/volume1/downloads/documentary
PATH_OTHER=/volume1/downloads/others

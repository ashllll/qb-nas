# qBittorrent 配置
QBIT_HOST=http://qbittorrent.local:8080
QBIT_USERNAME=your-username
QBIT_PASSWORD=your-password

# 服务配置
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8899
# 监听非 loopback 地址时必须设置强随机密钥
API_KEY=
# 仅限明确的本地开发场景；生产环境保持 false
ALLOW_INSECURE_WRITE_API=false

# 爬虫配置
CRAWLER_TIMEOUT=30
CRAWLER_MAX_DEPTH=2
CRAWLER_CONCURRENCY=6
CRAWLER_MAX_DETAIL_LINKS=200
CRAWLER_HEADLESS=true
CRAWLER_ALLOWED_RESOLUTIONS=2160p,4k
CRAWLER_WAIT_UNTIL=load
CRAWLER_DELAY_BEFORE_HTML=1.0
CRAWLER_SCAN_FULL_PAGE=true
CRAWLER_SCROLL_DELAY=0.2
CRAWLER_MAX_SCROLL_STEPS=8
CRAWLER_PROCESS_IFRAMES=true
CRAWLER_FLATTEN_SHADOW_DOM=true
CRAWLER_REMOVE_OVERLAYS=true
CRAWLER_REMOVE_CONSENT_POPUPS=true

# 下载路径完全由 qBittorrent API 自动管理
# 每个厂牌（如 SexArt）的路径通过 qB API createCategory 自动创建
#
# 可选：如果脚本和 qB 不在同一台机器上，且你需要脚本主动创建目录：
# FS_BASE_PATH=Z:\downloads   # Windows 通过 SMB 挂载 NAS
# FS_BASE_PATH=/downloads     # 脚本与 qB 在同一环境
# 留空则只依赖 qB API 管理目录

# 高级配置
MIN_DISK_SPACE_GB=10.0

# 站点 Cookie（需要登录的目标网站）
# JSON 格式，key=域名，value=完整Cookie字符串
# 获取方式：浏览器登录目标网站后 F12→Application→Cookies→全选复制
# 示例: SITE_COOKIES={"example.com": "uid=123; sid=abc"}
SITE_COOKIES={}

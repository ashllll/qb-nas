# qBittorrent 配置
QBIT_HOST=http://192.168.1.69:8085
QBIT_USERNAME=admin
QBIT_PASSWORD=128012

# MiniMax API 配置
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_MODEL=MiniMax-M2.5-highspeed
MINIMAX_THINKING_MODEL=MiniMax-M2.5
THINKING_RECHECK=true

# TTS 配置
TTS_ENABLED=false

# 服务配置
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8899

# 爬虫配置
CRAWLER_TIMEOUT=30
CRAWLER_MAX_DEPTH=2
CRAWLER_CONCURRENCY=3
CRAWLER_HEADLESS=true

# 下载路径配置 - 使用本地可写目录
PATH_MOVIE=/tmp/downloads/movies
PATH_TV=/tmp/downloads/tv
PATH_ANIME=/tmp/downloads/anime
PATH_MUSIC=/tmp/downloads/music
PATH_GAME=/tmp/downloads/games
PATH_SOFTWARE=/tmp/downloads/software
PATH_VARIETY=/tmp/downloads/variety
PATH_DOCUMENTARY=/tmp/downloads/documentary
PATH_OTHER=/tmp/downloads/others

# 路径配置
MIN_DISK_SPACE_GB=1.0
AUTO_CREATE_DIRS=true
PATH_TEMPLATE_ENABLED=false
